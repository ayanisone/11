 "sarvam_vocals": {
  "text": "இயக்கம் நிலை நிலத்தை பொறுத்து மாறுவதையே இயக்கம் தூரம் இடப்பெயர்வே வேகம் நேரம். புத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று தூர இயக்கம். பிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியாக இயக்கத்தில் அனுபவம் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது வேகமானதாகவும் மெதுவானதாகவும் உயரும் உள்ளது ஆய்வுக்கு கவனம் அவசியமாகும். இயக்கம் இல்லை நேரத்தை பொறுத்துமாறு கதையை இயக்கம் தூரம் இனப்பெயர்ப்பு வேரம் வேரம்.",
  "chunks": [
   {
    "start": 0.0,
    "end": 17.15,
    "text": "இயக்கம் நிலை நிலத்தை பொறுத்து மாறுவதையே இயக்கம் தூரம் இடப்பெயர்வே வேகம் நேரம்.",
    "lang": "ta-IN"
   },
   {
    "start": 17.15,
    "end": 30.2,
    "text": "புத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று தூர இயக்கம்.",
    "lang": "ta-IN"
   },
   {
    "start": 30.2,
    "end": 53.75,
    "text": "பிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியாக இயக்கத்தில் அனுபவம் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது வேகமானதாகவும் மெதுவானதாகவும் உயரும் உள்ளது ஆய்வுக்கு கவனம் அவசியமாகும்.",
    "lang": "ta-IN"
   },
   {
    "start": 53.75,
    "end": 68.04,
    "text": "இயக்கம் இல்லை நேரத்தை பொறுத்துமாறு கதையை இயக்கம் தூரம் இனப்பெயர்ப்பு வேரம் வேரம்.",
    "lang": "ta-IN"
   }
  ]
 },
 "sarvam_verbatim_vocals": {
  "text": "இயக்கம் நிலைநிரத்திப் போறது மாறுவதே இயக்கம் தூரம் இடப்பெயர்வே வேகம் நேரம் புத்தகம் விழுவது நீர் பாய்வது ஜன்னல்கள் அதிர்வது சுவாசிக்கும் காற்று தூர இயக்கம் பிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியாக இயக்கத்தில் அனுபவம் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது வேகமானதாகவும் மெதுவானதாகவும் உயரும் உள்ளது ஆய்வுக்கு கவனம் அவசியமாகும். இயக்கம் இல்லை நேரத்தை பொறுத்துமாறு கதையை இயக்கம் தூரம் இனப்பெயர்ப்பு வேரம் வேரம்",
