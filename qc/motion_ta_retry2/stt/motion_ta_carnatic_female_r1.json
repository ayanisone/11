 "sarvam_vocals": {
  "text": "இயக்கம் நிலை நேரத்தைக் பொறுத்து மாறுவதையே இயக்கம். தூரமிடப் பெயர்வு வேகம் நேரம். புத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று கூட இயக்கம். பிரபஞ்சத்தலைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில் அணுவும் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது.\nவேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது. ஆய்வுக்கு கவனம் அவசியமாகும்.\nஇயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.",
  "chunks": [
   {
    "start": 0.0,
    "end": 13.15,
    "text": "இயக்கம் நிலை நேரத்தைக் பொறுத்து மாறுவதையே இயக்கம். தூரமிடப் பெயர்வு வேகம் நேரம்.",
    "lang": "ta-IN"
   },
   {
    "start": 13.15,
    "end": 28.6,
    "text": "புத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று கூட இயக்கம்.",
    "lang": "ta-IN"
   },
   {
    "start": 28.6,
    "end": 53.15,
    "text": "பிரபஞ்சத்தலைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில் அணுவும் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது.\nவேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது.",
    "lang": "ta-IN"
   },
   {
    "start": 53.15,
    "end": 68.04,
    "text": "ஆய்வுக்கு கவனம் அவசியமாகும்.\nஇயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.",
    "lang": "ta-IN"
   }
  ]
 },
 "sarvam_verbatim_vocals": {
