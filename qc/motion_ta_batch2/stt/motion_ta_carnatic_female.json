 "sarvam_vocals": {
  "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம் தூரம் இடப்பெயர் வேகம் நேரம். புத்தகம் விழுவது, நீர்ப்பாய்வ ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று கூட இயக்கம்.\nபிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில். அணுவும் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தாலானது வேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது ஆய்வுக்கு கவனம் அவசியமாகும். இயக்கம் இலை நேரத்தைப் பொறுத்து நாறுவதையே இயக்கம் இடப்பெயர்வுக்கும் மேகம் நேரம்.",
  "chunks": [
   {
    "start": 0.0,
    "end": 12.65,
    "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம் தூரம் இடப்பெயர் வேகம் நேரம்.",
    "lang": "ta-IN"
   },
   {
    "start": 12.65,
    "end": 31.1,
    "text": "புத்தகம் விழுவது, நீர்ப்பாய்வ ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று கூட இயக்கம்.\nபிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில்.",
    "lang": "ta-IN"
   },
   {
    "start": 31.1,
    "end": 50.15,
    "text": "அணுவும் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தாலானது வேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது ஆய்வுக்கு கவனம் அவசியமாகும்.",
    "lang": "ta-IN"
   },
   {
    "start": 50.15,
    "end": 68.04,
    "text": "இயக்கம் இலை நேரத்தைப் பொறுத்து நாறுவதையே இயக்கம் இடப்பெயர்வுக்கும் மேகம் நேரம்.",
    "lang": "ta-IN"
   }
  ]
 },
