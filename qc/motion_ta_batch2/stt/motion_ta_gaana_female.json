 "sarvam_vocals": {
  "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயயர்வு வேகம் நேரம். புத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று கூட இயக்கம். பிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில், அனுகும் கூட நிலையான இயக்கத்தில். ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது, வேகமானதாகவோ? மெதுவானதாகவோ இயக்கம் உள்ளது, ஆய்வுக்கு கவனம் அவசியமாகும்.\nஇயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம். ",
  "chunks": [
   {
    "start": 0.0,
    "end": 15.85,
    "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயயர்வு வேகம் நேரம்.",
    "lang": "ta-IN"
   },
   {
    "start": 15.85,
    "end": 28.0,
    "text": "புத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது, சுவாசிக்கும் காற்று கூட இயக்கம்.",
    "lang": "ta-IN"
   },
   {
    "start": 28.0,
    "end": 42.05,
    "text": "பிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில், அனுகும் கூட நிலையான இயக்கத்தில். ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது, வேகமானதாகவோ?",
    "lang": "ta-IN"
   },
   {
    "start": 42.05,
    "end": 66.8,
    "text": "மெதுவானதாகவோ இயக்கம் உள்ளது, ஆய்வுக்கு கவனம் அவசியமாகும்.\nஇயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.",
    "lang": "ta-IN"
   },
   {
    "start": 66.8,
    "end": 68.04,
    "text": "",
    "lang": "ta-IN"
   }
  ]
 },
 "sarvam_verbatim_vocals": {
  "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம் தூரம் இடப்பெயயர்வு வேகம் நேரம் புத்தகம் விழுவது நீர் பாய்வது ஜன்னல்கள் அதிர்வது சுவாசிக்கும் காற்று கூட இயக்கம் பிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில் அணுகும் கூட நிலையான இயக்கத்தில் ஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது வேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது ஆய்வுக்கு கவனம் அவசியமாகும் இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம் தூரம் இடப்பெயர்வு வேகம் நேரம் ",
