 "sarvam_vocals": {
  "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.\nபுத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது. சுவாசிக்கும் காற்று கூட இயக்கம்.\nபிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில்.\nஅணுவும் கூட நிலையான இயக்கத்தில்.\nஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது. வேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது.\nஆய்வுக்கு கவனம் அவசியமாகும்.\nஇயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.",
  "chunks": [
   {
    "start": 0.0,
    "end": 22.55,
    "text": "இயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.\nபுத்தகம் விழுவது, நீர் பாய்வது, ஜன்னல்கள் அதிர்வது.",
    "lang": "ta-IN"
   },
   {
    "start": 22.55,
    "end": 43.4,
    "text": "சுவாசிக்கும் காற்று கூட இயக்கம்.\nபிரபஞ்சத்தில் அனைத்தும் இயங்குகின்றன தொடர்ச்சியான இயக்கத்தில்.\nஅணுவும் கூட நிலையான இயக்கத்தில்.\nஒவ்வொரு இயற்பியல் செயல்முறையும் இயக்கத்தால் ஆனது.",
    "lang": "ta-IN"
   },
   {
    "start": 43.4,
    "end": 68.04,
    "text": "வேகமானதாகவோ மெதுவானதாகவோ இயக்கம் உள்ளது.\nஆய்வுக்கு கவனம் அவசியமாகும்.\nஇயக்கம் நிலை நேரத்தைப் பொறுத்து மாறுவதையே இயக்கம்.\nதூரம் இடப்பெயர்வு வேகம் நேரம்.",
    "lang": "ta-IN"
   }
  ]
 },
